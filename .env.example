# Required server runtime. Copy to .env.local and replace placeholders.
# Obtain DATABASE_URL from the dedicated LightLine Neon development branch.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/lightline?sslmode=require
# Generate two DIFFERENT random secrets (at least 32 characters).
LIGHTLINE_TOOL_API_KEY=replace-with-a-random-tool-secret
OPERATOR_ACCESS_SECRET=replace-with-a-different-random-operator-secret
# Provider setup is performed in BimpeAI; the app does not need a BimpeAI API key.
